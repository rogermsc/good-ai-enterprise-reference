# Good AI Enterprise Reference - Environment Configuration
# Copy this file to .env and configure as needed

# Environment
ENVIRONMENT=development
DEBUG=false

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/goodai
DATABASE_POOL_SIZE=5

# LLM Configuration
# Set to "openai" to use real API, "mock" for deterministic testing
LLM_PROVIDER=mock

# OpenAI API Key (optional - system works in mock mode without it)
# OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Security
CORS_ORIGINS=["*"]
